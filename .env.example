# Learno.AI single environment file (root). Gitignored; never commit.
# Server reads every variable here. Only REACT_APP_* values are exposed to the browser.

# Server
PORT=4000
MONGODB_URL=mongodb://127.0.0.1:27017/learno
MAIL_HOST=
MAIL_USER=
MAIL_PASS=

# Clerk (auth). Secret key is server-only; publishable key is public.
CLERK_SECRET_KEY=
REACT_APP_CLERK_PUBLISHABLE_KEY=

# Razorpay test/sandbox. Key secret is server-only; key id is public.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=
REACT_APP_RAZORPAY_KEY_ID=

# Groq (AI features)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Cloudinary (only if uploads are used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FOLDER_NAME=

# Frontend
REACT_APP_BASE_URL=http://localhost:4000/api/v1
